# Your site's public URL, used for SEO tags (Open Graph, canonical,
# sitemap). Update this once you connect a custom domain.
NEXT_PUBLIC_SITE_URL=https://digitalplanet-sigma.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=xxxx

# DigiTrust reseller API
DIGITRUST_API_BASE=https://digitrust-bot-production.up.railway.app/api/v2
DIGITRUST_API_KEY=sk_your_key_here

# Stock safety buffer: units subtracted from DigiTrust's real stock
# before deciding what to show as available on your site
STOCK_BUFFER=2

# Your USDT (BEP20) receiving wallet address
PAYOUT_WALLET_ADDRESS=0xYourBep20WalletAddress

# Payments are verified by reading transaction receipts directly from
# free public BNB Smart Chain RPC nodes — no API key needed, nothing
# to sign up for.
# USDT BEP20 token contract on BNB Smart Chain
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Minimum confirmations before a payment counts as verified
MIN_CONFIRMATIONS=3

# Secret used to sign/verify admin routes (any long random string)
ADMIN_SECRET=change_me_to_something_long_and_random

# Cron protection: Vercel Cron sends this as a header/query so random
# people can't trigger your stock-sync endpoint
CRON_SECRET=change_me_too

# Optional: AI description rewrite (Admin -> AI text). Free key: aistudio.google.com
GEMINI_API_KEY=
